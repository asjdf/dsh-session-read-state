{
  "name": "dsh-session-read-state",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asjdf/dsh-session-read-state.git"
  },
  "description": "在侧栏会话上右键即可标为已读或未读，未读的会话在标题旁显示「新」标记。",
  "type": "module",
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
